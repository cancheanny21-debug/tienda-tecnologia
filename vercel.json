{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "bref/vercel-php"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/docs/$1"
    },
    {
      "src": "/productos",
      "dest": "/api/productos.php"
    },
    {
      "src": "/producto",
      "dest": "/api/producto.php"
    },
    {
      "src": "/carrito",
      "dest": "/api/carrito.php"
    },
    {
      "src": "/nosotros",
      "dest": "/api/nosotros.php"
    },
    {
      "src": "/contacto",
      "dest": "/api/contacto.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
